---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const POSTS_PER_PAGE = 10;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Build archive tree for sidebar
type MonthGroup = { id: string; name: string; count: number };
type YearGroup = { year: string; total: number; months: MonthGroup[] };

const archiveMap: Record<string, Record<string, number>> = {};
for (const post of sortedPosts) {
  const date = post.data.pubDate;
  const year = date.getFullYear().toString();
  const monthId = (date.getMonth() + 1).toString().padStart(2, '0');
  if (!archiveMap[year]) archiveMap[year] = {};
  archiveMap[year][monthId] = (archiveMap[year][monthId] ?? 0) + 1;
}

const archive: YearGroup[] = Object.keys(archiveMap)
  .sort((a, b) => Number(b) - Number(a))
  .map(year => {
    const months: MonthGroup[] = Object.keys(archiveMap[year])
      .sort((a, b) => Number(b) - Number(a))
      .map(monthId => {
        const date = new Date(Number(year), Number(monthId) - 1, 1);
        return {
          id: monthId,
          name: date.toLocaleString('vi-VN', { month: 'long' }),
          count: archiveMap[year][monthId],
        };
      });
    return {
      year,
      total: months.reduce((s, m) => s + m.count, 0),
      months,
    };
  });

// Serialize posts for client-side JS
const postsData = sortedPosts.map(post => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description ?? '',
  pubDate: post.data.pubDate.toISOString(),
  tags: post.data.tags ?? [],
  year: post.data.pubDate.getFullYear().toString(),
  monthId: (post.data.pubDate.getMonth() + 1).toString().padStart(2, '0'),
  slug: post.id.replace(/\.mdx?$/, ''),
}));
---

<BaseLayout
  title="Tất cả bài viết — congtc.cs"
  description="Danh sách tất cả bài viết về công nghệ thông tin, lập trình, DevOps."
  maxWidth="max-w-5xl"
>
  <div class="flex flex-col md:flex-row gap-10">

    <!-- ── LEFT SIDEBAR ── -->
    <aside class="md:w-52 shrink-0">
      <div class="sticky top-20">
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-1">
          Bài viết
        </h1>
        <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6 font-mono">
          {sortedPosts.length} bài viết
        </p>

        <nav class="hidden md:block space-y-5" id="archive-nav">
          <!-- "Tất cả" -->
          <button
            data-year="" data-month=""
            class="archive-btn cursor-pointer block w-full text-left text-sm font-medium text-zinc-900 dark:text-zinc-100 mb-2 transition-colors"
          >
            Tất cả <span class="font-mono opacity-50 ml-1">({sortedPosts.length})</span>
          </button>

          {archive.map(yearGroup => (
            <div>
              <!-- Year button -->
              <button
                data-year={yearGroup.year} data-month=""
                class="archive-btn cursor-pointer flex items-center justify-between w-full text-sm font-semibold text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors mb-2"
              >
                <span>{yearGroup.year}</span>
                <span class="font-mono text-xs opacity-50">{yearGroup.total}</span>
              </button>

              <!-- Month list (initially hidden, revealed by JS) -->
              <ul class="month-list space-y-1 border-l border-zinc-200 dark:border-zinc-800 ml-1 hidden" data-year={yearGroup.year}>
                {yearGroup.months.map(m => (
                  <li>
                    <button
                      data-year={yearGroup.year} data-month={m.id}
                      class="archive-btn cursor-pointer flex items-center justify-between w-full pl-4 py-0.5 text-sm text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
                    >
                      <span class="capitalize">{m.name}</span>
                      <span class="font-mono text-xs opacity-50">{m.count}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
    </aside>

    <!-- ── RIGHT CONTENT ── -->
    <div class="flex-1 min-w-0">
      <!-- Section header -->
      <div class="flex items-center justify-between mb-8">
        <h2 id="section-label" class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 capitalize">
          Tất cả bài viết
        </h2>
        <span id="section-meta" class="text-sm text-zinc-400 dark:text-zinc-500 font-mono">
          {sortedPosts.length} bài
        </span>
      </div>

      <!-- Posts list -->
      <div id="posts-list" class="flex flex-col"></div>

      <!-- Empty state -->
      <p id="empty-state" class="hidden text-zinc-400 dark:text-zinc-500 text-sm py-8 border-t border-zinc-100 dark:border-zinc-800">
        Không có bài viết nào.
      </p>

      <!-- Pagination -->
      <nav id="pagination" class="hidden flex items-center justify-between mt-12 pt-8 border-t border-zinc-100 dark:border-zinc-800">
        <button id="btn-prev" class="cursor-pointer inline-flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:border-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
          ← Trang trước
        </button>
        <div id="page-numbers" class="flex items-center gap-1"></div>
        <button id="btn-next" class="cursor-pointer inline-flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:border-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
          Trang sau →
        </button>
      </nav>
    </div>

  </div>
</BaseLayout>

<script is:inline define:vars={{ postsData, POSTS_PER_PAGE }}>
  let currentYear = '';
  let currentMonth = '';
  let currentPage = 1;

  function getFilteredPosts() {
    return postsData.filter(p => {
      if (currentYear && p.year !== currentYear) return false;
      if (currentMonth && p.monthId !== currentMonth) return false;
      return true;
    });
  }

  function formatDate(iso) {
    const d = new Date(iso);
    return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  function renderPosts() {
    const filtered = getFilteredPosts();
    const totalPages = Math.max(1, Math.ceil(filtered.length / POSTS_PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;

    const paged = filtered.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);

    // Update header
    const labelEl = document.getElementById('section-label');
    const metaEl = document.getElementById('section-meta');
    if (currentYear && currentMonth) {
      const d = new Date(Number(currentYear), Number(currentMonth) - 1, 1);
      const name = d.toLocaleString('vi-VN', { month: 'long' });
      labelEl.textContent = `${name} ${currentYear}`;
    } else if (currentYear) {
      labelEl.textContent = `Năm ${currentYear}`;
    } else {
      labelEl.textContent = 'Tất cả bài viết';
    }
    metaEl.textContent = filtered.length + ' bài' + (totalPages > 1 ? ` · trang ${currentPage}/${totalPages}` : '');

    // Render post cards
    const listEl = document.getElementById('posts-list');
    const emptyEl = document.getElementById('empty-state');
    
    // Trigger animation
    listEl.classList.remove('animate-fade-in');
    void listEl.offsetWidth; // trigger reflow
    listEl.classList.add('animate-fade-in');

    if (paged.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
    } else {
      emptyEl.classList.add('hidden');
      listEl.innerHTML = paged.map(post => `
        <article class="group">
          <a
            href="/blog/${post.slug}"
            class="block py-6 border-b border-zinc-100 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <!-- Tags -->
                ${post.tags.length > 0 ? `
                  <div class="flex flex-wrap gap-1.5 mb-2">
                    ${post.tags.slice(0, 3).map(tag => `
                      <span class="text-xs text-zinc-400 dark:text-zinc-500 font-mono uppercase tracking-wide">
                        #${tag}
                      </span>
                    `).join('')}
                  </div>
                ` : ''}

                <!-- Title -->
                <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-zinc-600 dark:group-hover:text-zinc-300 transition-colors mb-1.5 leading-snug">
                  ${post.title}
                </h2>

                <!-- Description -->
                <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed line-clamp-2">
                  ${post.description}
                </p>
              </div>

              <!-- Arrow -->
              <span class="text-zinc-300 dark:text-zinc-600 group-hover:text-zinc-500 dark:group-hover:text-zinc-400 transition-all group-hover:translate-x-0.5 mt-0.5 shrink-0">
                →
              </span>
            </div>

            <!-- Date -->
            <time
              datetime="${post.pubDate}"
              class="block mt-3 text-xs text-zinc-400 dark:text-zinc-500 font-mono"
            >
              ${formatDate(post.pubDate)}
            </time>
          </a>
        </article>
      `).join('');
    }

    // Render pagination
    const paginationEl = document.getElementById('pagination');
    if (totalPages <= 1) {
      paginationEl.classList.add('hidden');
      return;
    }
    paginationEl.classList.remove('hidden');

    // Prev / Next buttons
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    btnPrev.disabled = currentPage <= 1;
    btnNext.disabled = currentPage >= totalPages;

    // Page numbers with ellipsis
    const pageNumbersEl = document.getElementById('page-numbers');
    const pages = [];
    for (let i = 1; i <= totalPages; i++) {
      if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 2) {
        pages.push(i);
      }
    }
    // Add ellipsis
    const withEllipsis = [];
    for (let i = 0; i < pages.length; i++) {
      if (i > 0 && pages[i] - pages[i - 1] > 1) withEllipsis.push('...');
      withEllipsis.push(pages[i]);
    }

    pageNumbersEl.innerHTML = withEllipsis.map(p => {
      if (p === '...') return `<span class="px-2 text-sm text-zinc-400">…</span>`;
      const isActive = p === currentPage;
      return `<button data-page="${p}" class="page-btn cursor-pointer w-9 h-9 flex items-center justify-center rounded-lg text-sm transition-colors font-mono ${isActive ? 'bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 font-semibold' : 'text-zinc-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 dark:text-zinc-400'}">${p}</button>`;
    }).join('');

    // Bind page button events
    pageNumbersEl.querySelectorAll('.page-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentPage = Number(btn.dataset.page);
        renderPosts();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  function updateSidebarActive() {
    document.querySelectorAll('.archive-btn').forEach(btn => {
      const y = btn.dataset.year;
      const m = btn.dataset.month;
      const isActive = y === currentYear && m === currentMonth;
      if (isActive) {
        btn.classList.add('text-zinc-900', 'dark:text-zinc-100', 'font-semibold');
        btn.classList.remove('text-zinc-500', 'dark:text-zinc-400', 'text-zinc-400', 'dark:text-zinc-500');
      } else {
        btn.classList.remove('font-semibold');
      }
    });

    // Show/hide month lists
    document.querySelectorAll('.month-list').forEach(ul => {
      if (ul.dataset.year === currentYear) {
        ul.classList.remove('hidden');
      } else {
        ul.classList.add('hidden');
      }
    });
  }

  // Bind archive buttons
  document.querySelectorAll('.archive-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentYear = btn.dataset.year;
      currentMonth = btn.dataset.month;
      currentPage = 1;
      updateSidebarActive();
      renderPosts();
    });
  });

  // Prev / Next
  document.getElementById('btn-prev').addEventListener('click', () => {
    if (currentPage > 1) { currentPage--; renderPosts(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });
  document.getElementById('btn-next').addEventListener('click', () => {
    const total = Math.ceil(getFilteredPosts().length / POSTS_PER_PAGE);
    if (currentPage < total) { currentPage++; renderPosts(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });

  // Initial render
  renderPosts();
</script>
