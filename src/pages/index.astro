---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 5);
---

<BaseLayout
  title="congtc.cs — Blog công nghệ thông tin"
  description="Blog chia sẻ kiến thức về lập trình, DevOps, hệ thống, và công nghệ thông tin."
>
  <!-- Hero -->
  <section class="mb-16 animate-fade-in">
    <p class="text-xs font-mono text-zinc-400 dark:text-zinc-500 uppercase tracking-widest mb-4">
      Xin chào 👋
    </p>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4 leading-tight">
      Trần Chiến Công
    </h1>
    <p class="text-base text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-lg">
      Blog cá nhân — nơi tôi ghi lại những gì học được về lập trình, hệ thống, DevOps và
      mọi thứ liên quan đến công nghệ thông tin.
    </p>

    <div class="flex items-center gap-3 mt-6">
      <a
        href="/blog"
        id="hero-read-blog"
        class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 rounded-lg text-sm font-medium hover:bg-zinc-700 dark:hover:bg-zinc-300 transition-colors"
      >
        Đọc bài viết
        <span>→</span>
      </a>
      <a
        href="/about"
        id="hero-about"
        class="inline-flex items-center gap-2 px-4 py-2 border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 rounded-lg text-sm font-medium hover:border-zinc-400 dark:hover:border-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
      >
        Về tôi
      </a>
    </div>
  </section>

  <!-- Recent Posts -->
  <section class="animate-fade-in animate-delay-100">
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-widest">
        Bài viết gần đây
      </h2>
      <a
        href="/blog"
        id="home-view-all"
        class="text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors font-mono"
      >
        Xem tất cả →
      </a>
    </div>

    {recentPosts.length > 0 ? (
      <div>
        {recentPosts.map(post => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="text-zinc-400 dark:text-zinc-500 text-sm py-8 border-t border-zinc-100 dark:border-zinc-800">
        Chưa có bài viết nào. Hãy quay lại sau nhé!
      </p>
    )}
  </section>
</BaseLayout>
